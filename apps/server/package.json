{
  "name": "@ricochet/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config ../../config/vitest.package.ts",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "soak": "RICOCHET_SOAK_S=300 vitest run --config ../../config/vitest.package.ts src/server.test.ts"
  },
  "dependencies": {
    "@fastify/static": "catalog:",
    "@ricochet/bots": "workspace:*",
    "@ricochet/geom": "workspace:*",
    "@ricochet/protocol": "workspace:*",
    "@ricochet/sim": "workspace:*",
    "fastify": "catalog:",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/ws": "catalog:",
    "tsx": "catalog:"
  }
}
