  },
  "dependencies": {
    "@ricochet/netcode": "workspace:*",
    "@ricochet/renderer": "workspace:*",
    "@ricochet/protocol": "workspace:*",
    "@ricochet/geom": "workspace:*",
    "phaser": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vite": "catalog:",
    "@playwright/test": "catalog:"
  }
}
